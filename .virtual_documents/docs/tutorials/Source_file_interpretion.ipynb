from megalibpy import BaseParams, Source, Run, MEGAlibSource
from astropy.coordinates import SkyCoord


from megalibpy import test_data











base = BaseParams.read_from_file(test_data / "GRB_ml_template.source")


base.list_parameters()


run = Run.read_from_file(test_data / "GRB_ml_template.source")


run.list_parameters(source_detail  = True)


run.source.set_coordinate(SkyCoord(l = 0, b = 23, unit = "deg", frame = "galactic"))


run.list_parameters(source_detail  = True)





# read the source file
mega_source = MEGAlibSource(file_path = test_data / "GRB_ml_template.source")

# list the parameters of the file
mega_source.list_all_params()


# set source coordinare
mega_source.set_coordinate(SkyCoord(l = 3, b = 23, unit = "deg", frame = "galactic"))

# set the flux
mega_source.set_flux(20)


# You can list the full parameters
mega_source.save_source_file("test.source", should_print=True)
